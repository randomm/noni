__pycache__/
*.pyc
.venv/
uv.lock
noni.egg-info/
noni_noni.egg-info/
# build droppings: `python -m build` writes these into the tree it builds;
# they are copies of the package, not tracked content, and the scrub check reads
# git-tracked files only, so a copy that leaked in would be scanned as product
# source (see tests/test_wheel_contents.py, which builds into its own temp dir)
build/
dist/
.pytest_cache/
# coverage data: `coverage run` writes .coverage, parallel subprocess runs
# write .coverage.<host>.<pid>.<seq>, `coverage html` writes htmlcov/
.coverage
.coverage.*
htmlcov/
/.pi/work-state/
# local public-repo hygiene deny-list: never committed (issue #8 scrub check)
/.noni-scrub-denylist
# local adapter allow-list (integrations/): never committed
/.noni-adapter-allowlist
# per-issue scratch folders (tmp/issue-N/)
/tmp/
# local research artifacts (never commit)
/outputs/
/parallel-research/
